# Configuration commune à tous les composants (sourcée par scripts/lib.sh).
# Chaque valeur peut être surchargée par une variable d'environnement du même nom.

# Préfixe de toutes les ressources AWS (buckets, stacks, Lambdas…)
PROJECT=${PROJECT:-dnext-trade}
GROUP=${GROUP:-gr11}
AWS_REGION=${AWS_REGION:-eu-north-1}

# Catalogue de données (créé par data-platform, complété par backend)
GLUE_DB=${GLUE_DB:-dnext_trade}
ATHENA_WORKGROUP=${ATHENA_WORKGROUP:-${PROJECT}-wg}
GOLD_TABLE=${GOLD_TABLE:-mirror_matches}

# Rapports IA : profil d'inférence européen de Claude Haiku 4.5
BEDROCK_MODEL_ID=${BEDROCK_MODEL_ID:-eu.anthropic.claude-haiku-4-5-20251001-v1:0}
REPORT_LANGUAGE=${REPORT_LANGUAGE:-fr}
